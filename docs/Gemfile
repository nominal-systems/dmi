source "https://rubygems.org"

# GitHub Pages builds this site from the `docs/` folder of `master` with the
# `github-pages` gem, which pins Jekyll, kramdown and every whitelisted plugin.
# Using the same gem locally means `bundle exec jekyll build` produces exactly
# what will be published. To upgrade, run `bundle update github-pages`.
gem "github-pages", group: :jekyll_plugins

# Windows and JRuby do not include zoneinfo files, so bundle the tzinfo-data gem
# and associated library.
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

# Performance-booster for watching directories on Windows
gem "wdm", "~> 0.1.1", :platforms => [:mingw, :x64_mingw, :mswin]
